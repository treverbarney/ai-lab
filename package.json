{
  "name": "3d-ai-learning",
  "version": "0.7.0",
  "private": true,
  "description": "Visual, hands-on neural networks and AI learning",
  "author": "Trever Barney",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "node desktop/package.cjs",
    "test": "node --test test/*.test.cjs",
    "setup": "node setup/bootstrap.cjs",
    "doctor": "node setup/doctor.cjs",
    "package:mac": "node desktop/package.cjs --platform darwin --arch arm64",
    "phone": "node phone/standalone.cjs",
    "phone:private": "node phone/standalone.cjs --tailscale",
    "build:viewer": "esbuild workbench/viewer-source.js --bundle --format=esm --minify --outfile=workbench/viewer.js && node integrations/build.cjs",
    "agent:request": "node workbench/agent.cjs",
    "prestart": "npm run build:viewer",
    "prepackage": "npm run build:viewer",
    "prepackage:mac": "npm run build:viewer",
    "prephone": "npm run build:viewer",
    "prephone:private": "npm run build:viewer",
    "plugins": "node plugins/cli.cjs",
    "test:studio": "node test/studio.e2e.cjs",
    "test:cad": "node test/cad.e2e.cjs",
    "test:cad:geometry": "node test/cad-geometry.cjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.1.0",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xyflow/react": "12.12.0",
    "occt-import-js": "0.0.23",
    "online-3d-viewer": "0.18.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "web-push": "3.6.7"
  },
  "productName": "3D AI Learning"
}
